//janus_topshim_watchdog
//AU program to run topshim, and kill it after a while if not done.
//Data always copied to a folder with the name of the current experiment
//So that you can look at the data and see what might have gone wrong

// Calling option for this AU program:
// options are just topshim options as per topshim on command line


//example usage :- 
//janus_topshim_watchdog ordmax=8 tunea

// Emailing or otherwise on error is to be handled by calling AU program
// After shimming we do loopadj_fallback - this is to accout for the generally unknown amount
// of deuterated solvent in open access samples. No autophase is done here in order to save time
// and because in general we don't have "new autophase" available.

// handles need for TSO according to INSTRUM and solvent:
// If INSTRUM is arran (or in principle tobermory) AND solvent name contains D2O, 
// Then it will execute TSO rather than normal topshim


#include <time.h>
time_t now_s, dtime_s;		  	/* seconds since 1970 */
struct tm *now;	  		/* structure with year, month etc. */

char command[PATH_MAX];
char tscommand[PATH_MAX];
char experiment[100];
char reportdest[PATH_MAX];
char reportsource[PATH_MAX];
char tmp_str[PATH_MAX]; 
char datestamp[256];
char lockpath[PATH_MAX];
char pidpath[PATH_MAX];
char message[1023];
char topshim_option[255];
char instrum_name[256];
char solvent[256];
int pid;
int ts_major = GetTsVersionMajor();
int ts_minor = GetTsVersionMinor();
int ts_patch = GetTsVersionPl();

FILE *pidfile;
FILE *lockfile;

int debug=0; // set to 1 for testing 



GETCURDATA 


// write lock file
sprintf(lockpath, "%s/%s/topshim_lockfile", PathXWinNMRProg(),PathXWinNMRCurDir());
lockfile = fopen(lockpath, "wt");
fclose(lockfile);

// start the watchdog AU and then carry on

CPR_exec("xau topshimkiller", WAIT_START); 

//check if we need tso and either do that or normal topshim
FETCHPARS("INSTRUM",instrum_name)
FETCHPAR("SOLVENT", solvent);
if((strstr(solvent, "D2O")!=0) && ((strcmp(instrum_name, "tobermory") == 0) || (strcmp(instrum_name, "arran") == 0)) )
{
	XAU("tso","");
}
else
{
	
	sprintf(tscommand,"topshim plotall convcomp %s", cmd);
	XCMD(tscommand);
}



// short delay to make sure lock really reestablished
sleep(5);

// delete the lockfile  *and kill the killer program!!!!!* if topshim completes OK

remove(lockpath);  // get rid of the kil file!

sprintf(pidpath, "%s/%s/topshim_pidfile", PathXWinNMRProg(),PathXWinNMRCurDir());

/* try and open the file */
if (pidfile = fopen(pidpath, "rt")) 
{

	/* read the PID number */
	fscanf(pidfile, "%d", &pid);
	fclose(pidfile);

	/* kill the process! */
	Proc_err(INFO_OPT, "killing PID = %d !", pid);
	sprintf(command, "kill %d", pid);
	CPR_exec(command, CONT_EX);

}
 



// Check if it thinks it failed, and if so make sure it ABORTs to set the right value of AUERR
// so that the sampleproblems handling works


if (debug)
{
	Proc_err(DEF_ERR_OPT,"AUERR before loopadj=%d", AUERR);
}
if (AUERR)
{
	// Now set loop params without doing autophase, and ABORT because shim failed
	XAU("loopadj_fallback","quiet");
	ABORT
}
else
{
	// Now set loop params without doing autophase, but don't abort as shim was OK
	XAU("loopadj_fallback","quiet");
}

QUIT