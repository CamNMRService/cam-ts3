;selt1ir
;avance-version (12/01/11)
;T1 measurement using selective inversion recovery
;for magnetization transfer experiments
;
; Set zgoptns to -DCALC_SPOFFS to calculate the shaped pulse offset automatically
; from the chemical shift set as CNST21 ppm  - remember to measure this on a dataset where sr=0
; Set zgoptns to -DCALC_SP to automatically calculate the length and power of the selective 180
; based on bandwidth CNST55 (ppm!)

; with sanity checking of shaped pulse power against plw1 inside pp
;$CLASS=HighRes
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>


"p2=p1*2"
"d11=30m"
#   ifdef CALC_SPOFFS
"spoff2=bf1*(cnst21/1000000)-o1"
#   else
#   endif /*CALC_SPOFFS*/

#   ifdef CALC_SP
"p12=(bwfac2/(cnst55*bf2))*1000000"
"spw2=plw1/((p12*90.0)/(p1*totrot2))*((p12*90.0)/(p1*totrot2))*(integfac2*integfac2)"
#   endif /*CALC_SP*/

"cnst60=spw2"
"cnst60=cnst60"
"cnst61=plw1"
"cnst61=cnst61"
"acqt0=-p1*2/3.1416"


1 ze
  1m
  if "cnst60<cnst61" goto Passaq
  2u 
  print "Selective pulse power exceeds hard pulse!"
  goto HaltAcqu
  Passaq, 1m
2 d1
  p12:sp2:f1 ph1
  vd pl1:f1
  p1 ph2
  go=2 ph31
  d11 wr #0 if #0 ivd
  lo to 1 times td1
HaltAcqu, 1m
exit


ph1=0 2 
ph2=0 0 2 2 1 1 3 3
ph31=0 0 2 2 1 1 3 3


;pl1 : f1 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;vd : variable delay, taken from vd-list
;ns: 8 * n
;ds: 4
;CNST55: selective pulse bandwidth in ppm
;CNST21: selective pulse centre frequency in ppm
;td1: number of experiments = number of delays in vd-list
;FnMODE: undefined

;define VDLIST

;this pulse program produces a ser-file (PARMOD = 2D)



